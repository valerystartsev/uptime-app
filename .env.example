# Local PostgreSQL started by docker compose.
POSTGRES_DB=uptime
POSTGRES_USER=uptime
POSTGRES_PASSWORD=uptime_dev_password
POSTGRES_PORT=5432

# Backend configuration.
DATABASE_URL=postgres://uptime:uptime_dev_password@localhost:5432/uptime?sslmode=disable
HTTP_ADDR=:8080
FILES_DIR=uploads
JWT_SECRET=replace-with-a-local-secret-at-least-32-characters-long
JWT_ISSUER=uptime-backend
JWT_AUDIENCE=uptime-frontend
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
CORS_ALLOWED_ORIGIN=http://localhost:3000
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=lax
REFRESH_COOKIE_PATH=/
# REFRESH_COOKIE_DOMAIN=localhost
